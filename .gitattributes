# Models are stored with Git LFS (git lfs pull after cloning)
*.h5 filter=lfs diff=lfs merge=lfs -text
# Binary files: never convert line endings or diff as text
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ico binary

# Keep the training notebook out of the language bar (its embedded plots inflate the byte count)
*.ipynb linguist-detectable=false
