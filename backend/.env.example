# Copy to backend/.env and fill in. NEVER commit backend/.env (it is git-ignored).

# MongoDB connection string (local: mongodb://127.0.0.1:27017/datascoop)
MONGO_URI=

# Secret used to sign login tokens (JWT). REQUIRED, at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Token lifetime (default 8h)
JWT_EXPIRES_IN=8h

# Doctor registration key. Leave EMPTY to disable doctor self-registration (recommended for a public demo).
DOCTOR_SECRET_KEY=

# Allowed front-end origins for CORS, comma-separated (Vite dev server by default)
FRONTEND_ORIGIN=http://localhost:8080

# Python ML service (use 127.0.0.1, not localhost: Node may resolve localhost to IPv6)
ML_SERVICE_URL=http://127.0.0.1:5001

# Server bind address/port. 127.0.0.1 = this PC only; 0.0.0.0 = reachable from your LAN (phone/Android app)
HOST=127.0.0.1
PORT=5000
